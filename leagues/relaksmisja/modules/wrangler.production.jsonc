{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rtl",
  "account_id": "c4fb946ea49e60688d5b2efca9b495cf",
  "keep_vars": false,
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rtl",
      "database_id": "6311be03-b905-4f8e-9e9e-88a8ce36bbd6"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "rtl-banners"
    }
  ],
  "secrets": {
    "required": ["ADMIN_CODE"]
  },
  "observability": {
    "enabled": true
  }
}
